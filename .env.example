# Copy to .env and fill in locally. Never commit .env.
# CoinGecko Pro API key (Analyst plan). Server-side only: sent in the x-cg-pro-api-key header.
# Never prefix with VITE_, never put it in a URL, screenshot, log or export.
# Advanced server entry points only; pnpm start asks for your key interactively.
COINGECKO_API_KEY=

# Loopback only for the local MVP. Allowed values: 127.0.0.1, ::1, localhost.
HOST=127.0.0.1
PORT=8787

# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Optional overrides (paths relative to the repository root)
# CONFIG_PATH=config/default.json
# DATA_DIR=data
